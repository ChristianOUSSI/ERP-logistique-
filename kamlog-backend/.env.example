# ============================================================
# .env  Variables d'Environnement EVO-LOG SaaS
# CONFIDENTIEL  Ne jamais committer ce fichier
# ============================================================

# ─── Base de données PostgreSQL 17 ────────────────────────
DB_NAME=evolog_erp
DB_USER=EVO-LOG
DB_PASSWORD=CHANGE_ME_secure_password_2026
DATABASE_URL=postgresql+asyncpg://EVO-LOG:CHANGE_ME@localhost:5432/evolog_erp

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379/0

# ─── JWT Auth ─────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_super_secret_jwt_key_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MinIO (Stockage PDF) ─────────────────────────────────
# Note: ACCESS_KEY et SECRET_KEY correspondent souvent au ROOT_USER de Docker
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=EVO-LOG_minio
MINIO_SECRET_KEY=CHANGE_ME_minio_secret
MINIO_BUCKET_DOCUMENTS=EVO-LOG-documents
MINIO_SECURE=false

# ─── Email (pour notifications) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@evo-log.cm
SMTP_PASSWORD=CHANGE_ME_email_password
SMTP_FROM=EVO-LOG ERP <noreply@evo-log.cm>

# ─── Application ──────────────────────────────────────────
APP_NAME=EVO-LOG SaaS
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","https://evolog-erp.cm"]

# ─── Frontend (Next.js) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret

# ─── Celery ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis_password@localhost:6379/2
