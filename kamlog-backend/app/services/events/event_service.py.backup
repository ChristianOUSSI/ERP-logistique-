# app/services/events/event_service.py
"""
Real-time Event Broadcasting Service
Handles broadcasting of various real-time events through WebSocket connections.
"""
import json
import logging
from datetime import datetime
from typing import Dict, Any, Optional, List
from enum import Enum

from app.routers.ws import manager
from app.utils.logger import get_logger

logger = get_logger(__name__)

class EventType(str, Enum):
    """Types of events that can be broadcasted"""
    # Mission events
    MISSION_STATUS_UPDATE = "mission_status_update"
    MISSION_CREATED = "mission_created"
    MISSION_UPDATED = "mission_updated"
    MISSION_COMPLETED = "mission_completed"

    # Alert events
    FUEL_ALERT = "fuel_alert"
    CREDIT_ALERT = "credit_alert"
    LOW_STOCK_ALERT = "low_stock_alert"
    SYSTEM_ALERT = "system_alert"

    # Notification events
    NOTIFICATION_CREATED = "notification_created"
    NOTIFICATION_UPDATED = "notification_updated"

    # Financial events
    INVOICE_CREATED = "invoice_created"
    PAYMENT_RECEIVED = "payment_received"
    OVERDUE_INVOICE = "overdue_invoice"

    # Inventory events
    STOCK_LEVEL_CHANGED = "stock_level_changed"
    STOCK_RECEIVED = "stock_received"
    STOCK_SHIPPED = "stock_shipped"

    # User events
    USER_LOGIN = "user_login"
    USER_LOGOUT = "user_logout"

    # System events
    HEARTBEAT = "heartbeat"
    SYSTEM_STATUS = "system_status"

class EventService:
    """Service for broadcasting real-time events"""

    @staticmethod
    async def broadcast_event(event_type: EventType, data: Dict[str, Any],
                            user_ids: Optional[List[int]] = None,
                            broadcast_to_all: bool = False):
        """
        Broadcast an event to connected clients

        Args:
            event_type: Type of event being broadcasted
            data: Event data payload
            user_ids: List of user IDs to send to (if None and broadcast_to_all=False,
                     sends to all subscribers of this event type)
            broadcast_to_all: If True, broadcasts to all connected clients
        """
        event_message = {
            "type": event_type.value,
            "timestamp": datetime.utcnow().isoformat(),
            "data": data
        }

        try:
            if broadcast_to_all:
                await manager.broadcast(event_message)
                logger.debug(f"Broadcasted {event_type.value} event to all clients")
            elif user_ids:
                # Send to specific users
                for user_id in user_ids:
                    await manager.broadcast_to_user(user_id, event_message)
                logger.debug(f"Broadcasted {event_type.value} event to users: {user_ids}")
            else:
                # Send to subscribers of this event type
                await manager.broadcast_to_subscribers(event_type.value, event_message)
                logger.debug(f"Broadcasted {event_type.value} event to subscribers")

        except Exception as e:
            logger.error(f"Failed to broadcast {event_type.value} event: {e}")

    @staticmethod
    async def broadcast_mission_status_update(mission_id: int, new_status: str,
                                            user_ids: Optional[List[int]] = None):
        """Broadcast mission status update"""
        await EventService.broadcast_event(
            EventType.MISSION_STATUS_UPDATE,
            {
                "mission_id": mission_id,
                "new_status": new_status,
                "message": f"Mission {mission_id} status updated to {new_status}"
            },
            user_ids=user_ids
        )

    @staticmethod
    async def broadcast_fuel_alert(mission_id: int, écart_percent: float,
                                 référence: str, severity: str = "WARNING"):
        """Broadcast fuel siphoning alert"""
        await EventService.broadcast_event(
            EventType.FUEL_ALERT,
            {
                "mission_id": mission_id,
                "écart_percent": écart_percent,
                "référence": référence,
                "severity": severity,
                "message": f"Écart carburant de {écart_percent:.1f}% détecté pour la mission {référence}"
            },
            broadcast_to_all=True  # Alerts go to everyone
        )

    @staticmethod
    async def broadcast_credit_alert(tiers_id: int, raison_sociale: str,
                                   encours_data: Dict[str, Any]):
        """Broadcast credit limit alert"""
        await EventService.broadcast_event(
            EventType.CREDIT_ALERT,
            {
                "tiers_id": tiers_id,
                "raison_sociale": raison_sociale,
                "encours_data": encours_data,
                "message": encours_data.get("message", f"Alerte crédit pour {raison_sociale}")
            },
            broadcast_to_all=True
        )

    @staticmethod
    async def broadcast_low_stock_alert(article_id: int, nom_article: str,
                                      quantite_disponible: float, unité: str):
        """Broadcast low stock alert"""
        await EventService.broadcast_event(
            EventType.LOW_STOCK_ALERT,
            {
                "article_id": article_id,
                "nom_article": nom_article,
                "quantite_disponible": quantite_disponible,
                "unité": unité,
                "message": f"Stock faible: {nom_article} ({quantite_disponible} {unité})"
            },
            broadcast_to_all=True
        )

    @staticmethod
    async def broadcast_notification_created(notification_data: Dict[str, Any],
                                           user_ids: List[int]):
        """Broadcast newly created notification"""
        await EventService.broadcast_event(
            EventType.NOTIFICATION_CREATED,
            {
                "notification": notification_data,
                "message": f"Nouvelle notification: {notification_data.get('titre', 'Sans titre')}"
            },
            user_ids=user_ids
        )

    @staticmethod
    async def broadcast_invoice_created(facture_id: int, numéro_facture: str,
                                      montant_ttc: float, client_nom: str):
        """Broadcast newly created invoice"""
        await EventService.broadcast_event(
            EventType.INVOICE_CREATED,
            {
                "facture_id": facture_id,
                "numéro_facture": numéro_facture,
                "montant_ttc": montant_ttc,
                "client_nom": client_nom,
                "message": f"Facture {numéro_facture} créée pour {client_nom} ({montant_ttc:,.0f} XAF)"
            },
            broadcast_to_all=False  # Send to subscribers only
        )

    @staticmethod
    async def broadcast_heartbeat():
        """Broadcast system heartbeat"""
        await EventService.broadcast_event(
            EventType.HEARTBEAT,
            {
                "message": "System heartbeat",
                "timestamp": datetime.utcnow().isoformat()
            },
            broadcast_to_all=True
        )

# Global instance
event_service = EventService()